# Public site origin (canonical URLs / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://football-time-machine.vercel.app

# ─── Feedback System (Resend — production) ─────────────────────
# Secrets stay server-side only. Never use NEXT_PUBLIC_* for these.
#
# 1. Verify football-timemachine.com in Resend (Domains).
# 2. Create an API key in Resend.
# 3. Set the three variables below locally (.env.local) and in Vercel.
# 4. Redeploy after changing Vercel env vars.
# 5. Submit one real production test from the site.

RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=Football Time Machine <feedback@football-timemachine.com>
FEEDBACK_TO_EMAIL=

# Optional override (defaults to resend when the vars above are set)
# FEEDBACK_PROVIDER=resend

# Optional legacy provider
# FEEDBACK_PROVIDER=formspree
# FEEDBACK_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
# FEEDBACK_FORMSPREE_ID=your_form_id
